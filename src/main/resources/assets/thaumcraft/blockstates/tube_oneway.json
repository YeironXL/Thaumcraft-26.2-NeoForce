{
  "multipart": [
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "thaumcraft:block/transport_oneway"
      }
    },
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "model": "thaumcraft:block/transport_oneway",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "thaumcraft:block/transport_oneway",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "thaumcraft:block/transport_oneway",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "thaumcraft:block/transport_oneway",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "thaumcraft:block/transport_oneway",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_down"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_east"
      }
    }
  ]
}
