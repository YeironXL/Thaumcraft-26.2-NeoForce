{
  "multipart": [
    {
      "when": {
        "facing": "up",
        "enabled": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_open"
      }
    },
    {
      "when": {
        "facing": "up",
        "enabled": "false"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_closed"
      }
    },
    {
      "when": {
        "facing": "down",
        "enabled": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_open",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "down",
        "enabled": "false"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_closed",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "north",
        "enabled": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_open",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "enabled": "false"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_closed",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "enabled": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_open",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "south",
        "enabled": "false"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_closed",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "enabled": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_open",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "enabled": "false"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_closed",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "facing": "east",
        "enabled": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_open",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "enabled": "false"
      },
      "apply": {
        "model": "thaumcraft:block/transport_valve_closed",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_down"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_east"
      }
    }
  ]
}
