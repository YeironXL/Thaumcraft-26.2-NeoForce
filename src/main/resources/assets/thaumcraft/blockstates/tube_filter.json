{
  "multipart": [
    {
      "apply": {
        "model": "thaumcraft:block/tube_filter_core"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_down"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "thaumcraft:block/transport_tube_east"
      }
    }
  ]
}
